# ═════════════════════════════════════════════════════════════
# The Market Lion — Environment Variables (example)
# ═════════════════════════════════════════════════════════════
# Copy to .env and fill the secrets. NEVER commit .env to git.

# ── Core ──────────────────────────────────────────────────────
NODE_ENV=development
APP_ENV=development                     # development | staging | production
APP_NAME="The Market Lion"
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
PUBLIC_API_URL=http://localhost:8000

# ── Auth & Security ───────────────────────────────────────────
JWT_SECRET=replace-with-long-random-string-min-64-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRES_MIN=30
JWT_REFRESH_EXPIRES_DAYS=14
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4
TWO_FA_ISSUER="The Market Lion"
ENCRYPTION_KEY=replace-with-32-byte-base64-key  # for pgcrypto API key encryption

# ── Database ──────────────────────────────────────────────────
POSTGRES_USER=marketlion
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=marketlion
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://marketlion:change_me_strong_password@postgres:5432/marketlion
DATABASE_URL_SYNC=postgresql://marketlion:change_me_strong_password@postgres:5432/marketlion

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── Capital.com (REST + Streaming) ─────────────────────────────
CAPITAL_BASE_URL=https://api-capital.backend-capital.com
CAPITAL_DEMO_BASE_URL=https://demo-api-capital.backend-capital.com
CAPITAL_API_KEY=
CAPITAL_API_PASSWORD=
CAPITAL_IDENTIFIER=
CAPITAL_STREAM_URL=https://api-streaming-capital.backend-capital.com

# ── Exness (deferred — placeholder) ────────────────────────────
EXNESS_ENABLED=false
EXNESS_API_KEY=
EXNESS_API_SECRET=

# ── Market Data ────────────────────────────────────────────────
ALPHA_VANTAGE_KEY=
FMP_KEY=
FRED_API_KEY=
EIA_API_KEY=
NEWSAPI_KEY=
TWITTER_BEARER=
GDELT_ENABLED=true

# ── LLM / NLP ──────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
HF_TOKEN=
FINBERT_MODEL=ProsusAI/finbert
FINGPT_MODEL=AI4Finance/FinGPT-v3.1

# ── Payments ───────────────────────────────────────────────────
# HyperPay (MADA + Visa/MC for Saudi)
HYPERPAY_BASE_URL=https://eu-test.oppwa.com
HYPERPAY_ACCESS_TOKEN=
HYPERPAY_ENTITY_ID_MADA=
HYPERPAY_ENTITY_ID_VISA=
# Stripe (international Visa/MC + Apple Pay)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_APPLE_PAY_DOMAIN=
# PayPal
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# PayTabs (disabled by default per رزان)
PAYTABS_ENABLED=false
PAYTABS_PROFILE_ID=
PAYTABS_SERVER_KEY=

# ── Email ──────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="The Market Lion <noreply@marketlion.ai>"
SUPPORT_EMAIL=support@marketlion.ai

# ── SMS / 2FA backup ──────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ── Storage ────────────────────────────────────────────────────
S3_ENDPOINT=https://nyc3.digitaloceanspaces.com
S3_BUCKET=marketlion-prod
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── Observability ──────────────────────────────────────────────
SENTRY_DSN=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me

# ── Cloudflare ─────────────────────────────────────────────────
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# ── TradingView Charting Library ───────────────────────────────
# Embed mode (free) by default. Set to true after signing TV license.
TRADINGVIEW_LIBRARY_LICENSED=false

# ── Feature Flags ──────────────────────────────────────────────
FEATURE_AUTO_TRADING=true
FEATURE_NEWS_PIPELINE=true
FEATURE_BOOKMAP=true
FEATURE_RL_LEARNING=true
FEATURE_CHAT_AI=true

# ── Risk Limits (defaults — overridable from Admin) ────────────
DEFAULT_MAX_RISK_PCT=10
DEFAULT_MIN_RISK_PCT=1
DAILY_LOSS_LIMIT_PCT=3
WEEKLY_LOSS_LIMIT_PCT=7
MONTHLY_LOSS_LIMIT_PCT=15
EQUITY_DRAWDOWN_FLOOR_PCT=80
MAX_CONCURRENT_TRADES=5
CONFLUENCE_THRESHOLD_DEFAULT=80
